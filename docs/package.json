{
  "name": "do",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prebuild": "(git rev-parse --is-shallow-repository 2>/dev/null | grep -q true && git fetch --unshallow --quiet) || true",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "start:fast": "docusaurus start --no-open",
    "build:analyze": "npm run build -- --bundle-analyzer",
    "start:no-cache": "docusaurus clear && docusaurus start",
    "build:fast": "docusaurus build --no-minify",
    "check:go-examples": "node scripts/validate-go-code-blocks.js",
    "lint": "docusaurus write-heading-ids && prettier --check --cache . && npm run check:go-examples",
    "lint:fix": "docusaurus write-heading-ids && prettier --write --cache . && npm run check:go-examples",
    "build:en": "docusaurus build --locale en",
    "start:en": "docusaurus start --locale en"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.0",
    "@docusaurus/faster": "^3.10.0",
    "@docusaurus/plugin-css-cascade-layers": "^3.10.0",
    "@docusaurus/plugin-ideal-image": "^3.10.0",
    "@docusaurus/plugin-svgr": "^3.10.0",
    "@docusaurus/plugin-vercel-analytics": "^3.10.0",
    "@docusaurus/preset-classic": "3.10.0",
    "@docusaurus/theme-mermaid": "^3.10.0",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "^0.1.9",
    "classnames": "^2.3.2",
    "clsx": "^2.1.1",
    "posthog-docusaurus": "^2.0.5",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.0",
    "@docusaurus/tsconfig": "3.10.0",
    "@docusaurus/types": "3.10.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      "chrome >= 100",
      "edge >= 100",
      "firefox >= 100",
      "safari >= 15.4",
      "not dead"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
